# Ansible Vault password files
.vault_password
*.vault_password
vault_pass*

# Ansible temporary files
*.retry
.ansible/
ansible/known_hosts

# Environment files
.env
.env.local

# SSH keys
*.pem
*.key
id_rsa*

# 1Password credentials (if accidentally copied locally)
1password-credentials.json
op-credentials.json

# Operational notes that record live topology, tailnet addresses, or
# service exposure. These stay on the operator machine.
private/

# Claude Code local settings carry env vars and can carry credentials.
.claude/settings.local.json

# Operator inventory: real hosts and sites. Start from hosts.example.yml.
ansible/inventory/hosts.yml

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Python artifacts
__pycache__/
*.py[cod]

# Virtual environments
.venv/

# Logs
*.log

# Agent worktrees
.claude/worktrees/

