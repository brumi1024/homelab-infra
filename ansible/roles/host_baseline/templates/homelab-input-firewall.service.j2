[Unit]
Description=Homelab input firewall overlay
After=network-online.target docker.service tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/homelab-input-firewall start
ExecStop=/usr/local/sbin/homelab-input-firewall stop

[Install]
WantedBy=multi-user.target
