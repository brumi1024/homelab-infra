[Unit]
Description=Restrict the Docker monitoring proxy to the homelab VPS
After=docker.service tailscaled.service
Requires=docker.service
Wants=tailscaled.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/homelab-docker-proxy-firewall start
ExecStop=/usr/local/sbin/homelab-docker-proxy-firewall stop

[Install]
WantedBy=multi-user.target
