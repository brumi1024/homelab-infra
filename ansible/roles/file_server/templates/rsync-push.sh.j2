#!/bin/sh
# Rsync push job: {{ job.name }}
set -eu

SSH_KEY=/root/.ssh/id_rsync
KNOWN_HOSTS=/root/.ssh/known_hosts
SOURCE="{{ job.source }}"
TARGET="{{ job.target_user | default('root') }}@{{ job.target_host }}:{{ job.target_path }}"

# An unmounted or empty bind path must never reach rsync --delete: that would
# read as "the source is now empty" and wipe the target.
if [ ! -d "$SOURCE" ] || [ -z "$(ls -A "$SOURCE")" ]; then
  echo "{{ job.name }}: source $SOURCE is missing or empty, refusing to run" >&2
  exit 1
fi

if rsync {{ job.flags | default(file_server_rsync_default_flags) }}{{ ' --delete' if job.delete | default(false) | bool else '' }} \
    -e "ssh -i $SSH_KEY -o UserKnownHostsFile=$KNOWN_HOSTS" \
    "$SOURCE" "$TARGET"; then
{% if job.ping_url is defined and job.ping_url %}
  curl -fsS "{{ job.ping_url }}" >/dev/null 2>&1 || true
{% endif %}
  exit 0
fi

exit 1
