# Generated by Ansible from template
# Deployment: {{ ansible_date_time.iso8601 | default('unknown') }}
# Host: {{ inventory_hostname }}
# Site: {{ node_site | default('unknown') }}

COMPOSE_KOMODO_IMAGE_TAG="2"
COMPOSE_KOMODO_BACKUPS_PATH=/etc/komodo/backups

## Ignored for Sqlite.
KOMODO_DATABASE_USERNAME={{ lookup('community.general.onepassword', 'Komodo', field='komodo_db_username', vault=homelab_op_vault) }}
KOMODO_DATABASE_PASSWORD={{ lookup('community.general.onepassword', 'Komodo', field='komodo_db_password', vault=homelab_op_vault) }}

TZ=Etc/UTC

## Used for Oauth / Webhook url suggestion / Caddy reverse proxy.
KOMODO_HOST={{ lookup('community.general.onepassword', 'Komodo', field='komodo_host', vault=homelab_op_vault) }}
KOMODO_TITLE=Komodo
## Create a first Server with this name on fresh install.
KOMODO_FIRST_SERVER_NAME={{ inventory_hostname }}

KOMODO_DISABLE_CONFIRM_DIALOG=false

## Options: 1-sec, 5-sec, 15-sec, 1-min, 5-min, 15-min
KOMODO_MONITORING_INTERVAL="15-sec"
## Options: 5-min, 15-min, 1-hr, 2-hr, 6-hr, 12-hr, 1-day
KOMODO_RESOURCE_POLL_INTERVAL="1-hr"

KOMODO_WEBHOOK_SECRET={{ lookup('community.general.onepassword', 'Komodo', field='komodo_webhook_secret', vault=homelab_op_vault) }}
KOMODO_JWT_SECRET={{ lookup('community.general.onepassword', 'Komodo', field='komodo_jwt_secret', vault=homelab_op_vault) }}

KOMODO_LOCAL_AUTH=true
KOMODO_DISABLE_USER_REGISTRATION=true
KOMODO_ENABLE_NEW_USERS=false
KOMODO_DISABLE_NON_ADMIN_CREATE=false
KOMODO_TRANSPARENT_MODE=false

## Options: 1-hr, 12-hr, 1-day, 3-day, 1-wk, 2-wk
KOMODO_JWT_TTL="1-day"

KOMODO_OIDC_ENABLED=true
## Must be reachable from the Komodo Core container.
KOMODO_OIDC_PROVIDER={{ lookup('community.general.onepassword', 'Komodo', field='komodo_oidc_provider', vault=homelab_op_vault) }}
KOMODO_OIDC_REDIRECT_HOST={{ lookup('community.general.onepassword', 'Komodo', field='komodo_oidc_redirect_host', vault=homelab_op_vault) }}
KOMODO_OIDC_CLIENT_ID={{ lookup('community.general.onepassword', 'Komodo', field='komodo_oidc_client_id', vault=homelab_op_vault) }}
KOMODO_OIDC_CLIENT_SECRET={{ lookup('community.general.onepassword', 'Komodo', field='komodo_oidc_client_secret', vault=homelab_op_vault) }}

KOMODO_GITHUB_OAUTH_ENABLED=false
KOMODO_GOOGLE_OAUTH_ENABLED=false

PERIPHERY_ROOT_DIRECTORY={{ komodo_root_directory }}
