## Generated by Ansible. Environment variables in compose.env override these.
init_admin_username = "{{ lookup('community.general.onepassword', 'Komodo', field='username', vault=homelab_op_vault) }}"
init_admin_password = "{{ lookup('community.general.onepassword', 'Komodo', field='password', vault=homelab_op_vault) }}"

[[git_provider]]
domain = "github.com"
accounts = [
  { username = "{{ lookup('community.general.onepassword', 'Komodo Github Provider Account', field='username', vault=homelab_op_vault) }}", token = "{{ lookup('community.general.onepassword', 'Komodo Github Provider Account', field='token', vault=homelab_op_vault) }}" },
]

[secrets]
{% set komodo_core_toml_api_key = lookup('community.general.onepassword', 'Komodo', field='komodo_api_key', vault=homelab_op_vault, errors='ignore') %}
{% set komodo_core_toml_api_secret = lookup('community.general.onepassword', 'Komodo', field='komodo_api_secret', vault=homelab_op_vault, errors='ignore') %}
{% if komodo_core_toml_api_key %}
KOMODO_API_KEY = "{{ komodo_core_toml_api_key }}"
{% endif %}
{% if komodo_core_toml_api_secret %}
KOMODO_API_SECRET = "{{ komodo_core_toml_api_secret }}"
{% endif %}
OP_SERVICE_ACCOUNT_TOKEN = "{{ lookup('community.general.onepassword', 'Komodo Homelab Access Token: Komodo Homelab Stacks', field='credential', vault=homelab_op_vault) }}"
OP_VAULT_UUID = "{{ lookup('community.general.onepassword', 'Komodo Homelab Credentials File', field='op_vault_uuid', vault=homelab_op_vault) }}"
OP_CREDENTIALS_BASE64 = "{{ lookup('community.general.onepassword_doc', 'Komodo Homelab Credentials File', vault=homelab_op_vault) | b64encode | replace('\n', '') }}"
