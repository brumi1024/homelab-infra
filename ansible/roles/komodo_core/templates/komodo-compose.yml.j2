# Deploys MongoDB, Komodo Core, and Komodo Periphery.

services:
  mongo:
    image: mongo
    labels:
      komodo.skip: # Prevent Komodo from stopping with StopAllContainers
    command: --quiet --wiredTigerCacheSizeGB {{ komodo_mongo_cache_size_gb }}
    restart: unless-stopped
    volumes:
      - mongo-data:/data/db
      - mongo-config:/data/configdb
    environment:
      MONGO_INITDB_ROOT_USERNAME: ${KOMODO_DATABASE_USERNAME}
      MONGO_INITDB_ROOT_PASSWORD: ${KOMODO_DATABASE_PASSWORD}
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          mongosh --quiet --host 127.0.0.1
          --username "$${MONGO_INITDB_ROOT_USERNAME}"
          --password "$${MONGO_INITDB_ROOT_PASSWORD}"
          --authenticationDatabase admin
          --eval 'quit(db.runCommand({ ping: 1 }).ok ? 0 : 1)'
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 20s

  core:
    image: ghcr.io/moghtech/komodo-core:${COMPOSE_KOMODO_IMAGE_TAG:-2}
    labels:
      komodo.skip: # Prevent Komodo from stopping with StopAllContainers
    init: true
    restart: unless-stopped
    depends_on:
      mongo:
        condition: service_healthy
    ports:
{% for address in komodo_core_resolved_bind_addresses %}
      - {{ address }}:{{ komodo_port }}:9120
{% endfor %}
    env_file: ./compose.env
    environment:
      KOMODO_DATABASE_ADDRESS: mongo:27017
    networks:
      default:
      vps-ingress:
        aliases:
          - {{ komodo_core_network_alias }}
    volumes:
      ## Core/Periphery PKI key material (core.pub / periphery.pub)
      - keys:/config/keys
      ## Dated database backups - https://komo.do/docs/setup/backup
      - ${COMPOSE_KOMODO_BACKUPS_PATH}:/backups
      ## Store sync files on server
      - ${PERIPHERY_ROOT_DIRECTORY}/syncs:/syncs
      - {{ komodo_install_dir }}/core.config.toml:/config/config.toml:ro
volumes:
  # Mongo
  mongo-data:
  mongo-config:
  # Core / Periphery PKI keys
  keys:

networks:
  vps-ingress:
    external: true
    name: vps-ingress
